[Unit]
Description=A.L.I.S.H.A. ESP32 HUD bridge (USB mic + touch HUD)
After=pipewire.service pipewire-pulse.service
Before=alisha-voice.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/Documents/ALISHA-Setup/esp32-hud/host/alisha_hud_bridge.py
Restart=on-failure
RestartSec=3
# hardening (all work in a user service)
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
