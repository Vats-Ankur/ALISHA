// A.L.I.S.H.A. fastfetch config — cyan HUD system banner
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "kali",
        "padding": { "top": 1, "left": 2 }
    },
    "display": {
        "separator": " ▸ ",
        "color": { "keys": "1", "title": "cyan" }
    },
    "modules": [
        { "type": "custom", "format": "\u001b[36m╺━━━━━━━━━━━━━━━ \u001b[1mA.L.I.S.H.A.\u001b[0m\u001b[36m ━━━━━━━━━━━━━━━╸\u001b[0m" },
        { "type": "custom", "format": "\u001b[38;5;24m  Advanced Learning Intelligent System for Human Assistance\u001b[0m" },
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "os", "key": "OS   " },
        { "type": "kernel", "key": "KERN " },
        { "type": "uptime", "key": "UP   " },
        { "type": "packages", "key": "PKGS " },
        { "type": "shell", "key": "SHELL" },
        { "type": "de", "key": "DE   " },
        { "type": "terminal", "key": "TERM " },
        "break",
        { "type": "cpu", "key": "CPU  ", "temp": true },
        { "type": "gpu", "key": "GPU  " },
        { "type": "memory", "key": "MEM  " },
        { "type": "swap", "key": "SWAP " },
        { "type": "disk", "key": "DISK ", "folders": "/" },
        { "type": "localip", "key": "LAN  " },
        "break",
        { "type": "custom", "format": "\u001b[36m╺━━━━━━━━━━━━━━━━━━━ \u001b[0mALL SYSTEMS NOMINAL \u001b[36m━━━━━━━━━━━━━━━━━━╸\u001b[0m" },
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
